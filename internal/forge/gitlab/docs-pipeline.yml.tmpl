# Generated by `koryph ci setup --kind docs`. Do not edit by hand; re-run the
# command to update.
#
# GitLab Pages docs-publish pipeline.
#
# Builds the Zensical documentation strictly and deploys it to GitLab Pages on every
# push to the default branch. Pages are published at:
#   https://<namespace>.gitlab.io/<project-path>/
#
# Prerequisites:
#   - mkdocs.yml at the repository root
#   - Zensical declared in docs/requirements.txt
#
# To serve locally:
#   pip install -r docs/requirements.txt
#   zensical serve

stages:
  - deploy

pages:
  stage: deploy
  image: python:3.12-slim
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
  script:
    - pip install --quiet -r docs/requirements.txt
    - rm -rf docs/designs
    - zensical build --strict --site-dir public
  artifacts:
    paths:
      - public
    expire_in: 1 week
  environment:
    name: pages
    url: $CI_PAGES_URL

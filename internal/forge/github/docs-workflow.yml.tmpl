# Generated by `koryph ci setup --kind docs`. Do not edit by hand; re-run the
# command to update.
#
# GitHub Pages docs-publish workflow. Builds the Zensical book strictly, then
# publishes its site artifact without creating a gh-pages branch.
#
# Prerequisites:
#   - mkdocs.yml and docs/requirements.txt at the repository root
#   - Zensical declared in docs/requirements.txt

name: docs

on:
  push:
    branches: [{{printf "%q" .DefaultBranch}}]
  workflow_dispatch:

# One concurrent Pages deployment; let an in-flight deploy finish.
concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    name: build (zensical --strict)
    runs-on: ubuntu-latest
    # configure-pages reads the existing Pages configuration; the build must
    # not receive the deployment or OIDC credentials.
    permissions:
      contents: read
      pages: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: docs/requirements.txt
      - run: pip install -r docs/requirements.txt
      # zensical does not implement mkdocs.yml's exclude_docs yet. Exclude
      # designs/ on the disposable CI checkout before the strict site build.
      - run: rm -rf docs/designs
      - run: zensical build --strict
      - uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d # v6.0.0
      - uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: site

  deploy:
    name: deploy to GitHub Pages
    needs: build
    runs-on: ubuntu-latest
    # Only the dedicated deployment job can publish and mint the Pages OIDC token.
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{"{{"}} steps.deployment.outputs.page_url {{"}}"}}
    steps:
      - id: deployment
        uses: actions/deploy-pages@cd2ce8fcbc39b97be8ca5fce6e763baed58fa128 # v5.0.0
